#include <stdio.h>

int main() {
    float gross = 12000, allowances = 0, deductions = 0, net;

    if (gross > 10000) {
        allowances = 0.10 * gross;
        deductions = 0.03 * gross;
    } else if (gross > 5000) {
        allowances = 0.07 * gross;
        deductions = 0.02 * gross;
    }

    net = gross + allowances - deductions;
    printf("Net Salary = %.2f\n", net);
    return 0;
}
