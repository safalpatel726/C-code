#include <stdio.h>

int main() {
    float s1 = 75, s2 = 65, s3 = 80, total, avg;

    total = s1 + s2 + s3;
    avg = total / 3.0;

    printf("Total = %.2f, Average = %.2f\n", total, avg);

    if (s1 < 35 || s2 < 35 || s3 < 35) {
        printf("Result: Fail (Scored < 35 in a subject)\n");
    } else if (avg >= 70) {
        printf("Grade: Distinction\n");
    } else if (avg >= 60) {
        printf("Grade: First Class\n");
    } else if (avg >= 50) {
        printf("Grade: Second Class\n");
    } else if (avg >= 35) {
        printf("Grade: Third Class\n");
    } else {
        printf("Result: Fail\n");
    }

    return 0;
}
